# Required. Obtain through the approved TiDB Cloud Clinic access workflow.
CLINIC_API_KEY=<set-this-via-approved-clinic-access-workflow>

# Optional endpoint override.
CLINIC_ENDPOINT=https://clinic.pingcap.com

# Optional default timezone used to interpret timestamps without explicit offsets.
INSPECTION_TIMEZONE=Asia/Shanghai

# Feishu/Lark delivery no longer uses .env for credentials: authenticate the global
# `lark-cli` with `lark-cli auth login` (OAuth; stored in the OS keychain).
# Delivery TARGET is configured in config/delivery.v1.json; the environment-specific
# root (Wiki node or Drive folder) token is read from this env var — set it per
# deployment so the skill stays portable:
FEISHU_PARENT_TOKEN=
